#! /usr/bin/env bash
# install2:  developer install using pure pip, no venv

cp dysh2.rc dysh.rc

# python 
rm -rf anaconda3 
./install_anaconda3 wget=wgetc
source anaconda3/python_start.sh
pip3 install --upgrade pip
