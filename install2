# dysh
rm -rf dysh
if [ -e dysh.tar ]; then
  echo Using dysh.tar    
  tar xf dysh.tar
else
  git clone https://github.com/GreenBankObservatory/dysh
fi
cd dysh
pip install --group dev -e .[all]


